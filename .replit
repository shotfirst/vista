run = "PORT=5000 npm start"
entrypoint = "server.js"
modules = ["web", "nodejs-18", "python-base-3.13"]

[deployment]
run = ["sh", "-c", "npm install && PORT=5000 npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
